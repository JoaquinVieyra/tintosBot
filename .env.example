# Copiá este archivo como .env y completá los valores reales.
# NUNCA subas el .env (con tus claves reales) a un repositorio público.

# --- WhatsApp Cloud API ---
# Los conseguís en developers.facebook.com, dentro de tu app de WhatsApp Business.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Vos inventás este valor (cualquier string), y lo repetís al configurar el
# webhook en el panel de Meta - sirve para que Meta confirme que sos vos.
WHATSAPP_VERIFY_TOKEN=elegi-una-clave-larga-random

# --- Google Sheets ---
# ID de la planilla (está en la URL: docs.google.com/spreadsheets/d/ESTE_ID/edit)
GOOGLE_SHEET_ID=
# Ruta al JSON de la cuenta de servicio de Google Cloud
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# --- Anthropic ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# --- Reglas del equipo ---
# Alias/CBU/nombre de cuenta al que deberían transferir - ayuda a Claude a
# marcar como sospechoso un comprobante destinado a otra cuenta.
CUENTA_DESTINO_ESPERADA=equipo.basquet.mp
